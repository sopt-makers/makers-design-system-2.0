{
  "name": "@sopt-mds/ui",
  "version": "1.0.14",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sopt-mds/design-tokens": "workspace:*",
    "@sopt-mds/icons": "workspace:*",
    "@vanilla-extract/css": "^1.15.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@sopt-mds/tsconfig": "workspace:*",
    "@sopt-mds/vite": "workspace:*",
    "@storybook/blocks": "^8.4.7",
    "@storybook/preview-api": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@vanilla-extract/vite-plugin": "^4.0.19",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-dts": "^4.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./index.css": "./dist/index.css",
      "./package.json": "./package.json"
    }
  }
}
