{
  "name": "@sopt-mds/design-tokens",
  "version": "1.0.3",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sopt-mds/tsconfig": "workspace:*",
    "@sopt-mds/vite": "workspace:*",
    "@storybook/react": "^8.4.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-dts": "^4.5.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./index.css": "./dist/index.css",
      "./package.json": "./package.json"
    }
  }
}
