{
  "name": "@sopt-mds/design-tokens",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "zshy": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "zshy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sopt-mds/tsconfig": "workspace:*",
    "@storybook/react": "^8.4.7",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "zshy": "^0.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
